{
  "runcontract": 1,
  "services": [
    {
      "name": "admin",
      "dir": "admin",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}",
        "--strictPort"
      ],
      "port": 5174,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "main.py"
      ],
      "depends_on": [
        "db"
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "WORKER_POLL_INTERVAL": {
          "dev": "5"
        },
        "HOT_SCORE_INTERVAL": {
          "dev": "300"
        },
        "SESSION_CLEANUP_INTERVAL": {
          "dev": "3600"
        }
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ]
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "static",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "test": [
        [
          "npm",
          "test"
        ]
      ],
      "serve_dir": "dist",
      "port": 5173,
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/health",
        "expect_status": [
          200
        ]
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest"
        ]
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "CORS_ORIGINS": {
          "dev": "${service:web.origin},${service:admin.origin}"
        },
        "RATE_LIMIT_PER_MINUTE": {
          "dev": "30"
        }
      }
    }
  ]
}
